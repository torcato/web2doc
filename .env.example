# Copy this file to .env and uncomment one provider configuration.
# Never put real credentials in this example or commit your .env file.

# -----------------------------------------------------------------------------
# Model selection
# -----------------------------------------------------------------------------

# Use separate models when exploration should be fast and documentation should
# use a more capable prose model. Command-line --model always takes precedence.
# WEB2DOC_DISCOVERY_MODEL=google-cloud:YOUR_FAST_VERTEX_MODEL_ID
# WEB2DOC_DOCUMENTATION_MODEL=google-cloud:YOUR_DOCUMENTATION_VERTEX_MODEL_ID

# Alternatively, use one model for both exploration and documentation.
# Purpose-specific settings above take precedence over this shared fallback.
# WEB2DOC_LLM_MODEL=openai:YOUR_OPENAI_MODEL_ID

# -----------------------------------------------------------------------------
# Vertex AI with a service-account JSON file
# -----------------------------------------------------------------------------

# Use the google-cloud: prefix for Gemini or compatible Model Garden models
# served through Vertex AI. Use an absolute credential path and chmod 600 it.
# WEB2DOC_DISCOVERY_MODEL=google-cloud:YOUR_VERTEX_MODEL_ID
# WEB2DOC_DOCUMENTATION_MODEL=google-cloud:YOUR_VERTEX_MODEL_ID
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# GOOGLE_CLOUD_LOCATION=europe-west4

# -----------------------------------------------------------------------------
# Vertex AI with local Application Default Credentials
# -----------------------------------------------------------------------------

# First run: gcloud auth application-default login
# Then no GOOGLE_APPLICATION_CREDENTIALS value is needed.
# WEB2DOC_DISCOVERY_MODEL=google-cloud:YOUR_VERTEX_MODEL_ID
# WEB2DOC_DOCUMENTATION_MODEL=google-cloud:YOUR_VERTEX_MODEL_ID
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# -----------------------------------------------------------------------------
# Gemini Developer API (Google AI Studio, not Vertex AI)
# -----------------------------------------------------------------------------

# Use google: rather than google-cloud: for the Gemini Developer API.
# WEB2DOC_DISCOVERY_MODEL=google:YOUR_GEMINI_MODEL_ID
# WEB2DOC_DOCUMENTATION_MODEL=google:YOUR_GEMINI_MODEL_ID
# GOOGLE_API_KEY=your-google-api-key

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------

# WEB2DOC_DISCOVERY_MODEL=openai:YOUR_OPENAI_MODEL_ID
# WEB2DOC_DOCUMENTATION_MODEL=openai:YOUR_OPENAI_MODEL_ID
# OPENAI_API_KEY=your-openai-api-key

# Optional: point the OpenAI provider at a compatible API endpoint.
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint.example/v1

# -----------------------------------------------------------------------------
# Browser runtime options
# -----------------------------------------------------------------------------

# Use an installed Chrome channel instead of Playwright's bundled Chromium.
# WEB2DOC_BROWSER_CHANNEL=chrome

# Or provide a specific browser executable. Do not set both unless required by
# your environment.
# WEB2DOC_BROWSER_EXECUTABLE_PATH=/absolute/path/to/chromium

# Slow browser actions for headed debugging. Range: 0 to 10000 milliseconds.
# WEB2DOC_BROWSER_SLOW_MO_MS=250
